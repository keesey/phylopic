    },
    "dependencies": {
        "@phylopic/utils": "*",
        "jsonwebtoken": "^9.0.3"
    },
    "description": "Types, validation, and normalization for *PhyloPic* source model objects.",
    "devDependencies": {
        "@phylopic/tsconfig": "*",
        "@types/jsonwebtoken": "^9.0.10",
        "eslint": "^8.57.0",
        "eslint-config-phylopic": "*",
        "prettier": "^3.9.6",
        "ts-node": "^10.9.2",
        "tsup": "^8.5.1",
        "typescript": "^5.4.5",
        "vitest": "^4.1.10",
        "yarn": "^1.22.22"
    },
    "exports": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "default": "./dist/index.js"
    },
    "files": [
        "dist/**"
    ],
    "homepage": "https://github.com/keesey/phylopic/packages/source-models#readme",
    "keywords": [
        "PhyloPic"
    ],
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "name": "@phylopic/source-models",
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/keesey/phylopic.git"
    },
    "resolutions": {
        "@types/node": "*"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
        "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
        "lint": "TIMING=1 eslint --fix src/**/*.ts*",
        "test": "vitest --watch=false"
    },
    "types": "./dist/index.d.ts",
    "version": "1.1.3"
}
