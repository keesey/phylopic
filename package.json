{
    "author": {
        "email": "keesey+phylopic@gmail.com",
        "name": "T. Michael Keesey"
    },
    "bugs": {
        "url": "https://github.com/keesey/phylopic/issues"
    },
    "dependencies": {},
    "description": "An open database of freely reusable silhouettes of life forms.",
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "eslint-config-phylopic": "*",
        "knip": "^5.80.0",
        "prettier": "^3.9.6",
        "turbo": "^2.10.9"
    },
    "license": "MIT",
    "name": "phylopic",
    "private": true,
    "resolutions": {
        "@aws-sdk/client-s3": "3.1093.0",
        "brace-expansion": "2.1.4",
        "core-js-compat": "3.46.0",
        "cssstyle": "4.2.1",
        "fast-uri": "3.1.5",
        "html-encoding-sniffer": "4.0.0",
        "js-yaml": "4.3.1",
        "jsdom": "26.1.0",
        "nanoid": "3.3.18",
        "phin": "3.7.1",
        "postcss": "8.5.26",
        "serialize-javascript": "7.0.5",
        "sharp": "0.35.0",
        "xml2js": "0.6.2"
    },
    "repository": "https://github.com/keesey/phylopic",
    "scripts": {
        "build": "turbo run build",
        "clean": "turbo run clean && rm -rf node_modules",
        "dev": "turbo run dev --cache=local:r,remote:r --parallel --continue",
        "format": "prettier --write \"**/*.{js,json,md,ts,tsx}\"",
        "lint": "turbo run lint",
        "knip": "knip",
        "make": "turbo run make --filter=@phylopic/publish",
        "test": "turbo run test"
    },
    "version": "2.0.61",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "packageManager": "yarn@1.22.22"
}
